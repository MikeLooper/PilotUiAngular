{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "test: all",
      "detail": "Run every unit test once (npm test).",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "test: current file",
      "detail": "Run the spec for the active editor file (a spec, or the production file beside it).",
      "type": "shell",
      "command": "npx ng test --watch=false --include \"${relativeFile}\"",
      "group": "test",
      "problemMatcher": "$tsc",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "test: watch",
      "detail": "Re-run affected unit tests whenever files change.",
      "type": "shell",
      "command": "npx ng test --watch",
      "group": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Building\\.\\.\\."
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "test: debug current file (wait for debugger)",
      "detail": "Used by the 'Debug unit tests: current file' launch configuration.",
      "type": "shell",
      "command": "npx ng test --watch=false --debug --include \"${relativeFile}\"",
      "isBackground": true,
      "problemMatcher": {
        "owner": "ng-test-debug",
        "pattern": {
          "regexp": "^__no_problems__$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Building\\.\\.\\."
          },
          "endsPattern": {
            "regexp": "Debugger listening on"
          }
        }
      }
    }
  ]
}
